<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local.mysql.mysqld-safe</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/mysql/support-files/mysqld-safe-launchd.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>UserName</key>
	<string>root</string>
	<key>WorkingDirectory</key>
	<string>/usr/local/mysql</string>
	<key>StandardOutPath</key>
	<string>/usr/local/mysql/data/mysqld-safe-launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/mysql/data/mysqld-safe-launchd.log</string>
</dict>
</plist>
