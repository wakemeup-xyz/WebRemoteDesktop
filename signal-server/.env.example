# Copy to signal-server/.env for local development
# Replace every placeholder before running outside an isolated local environment.

PORT=8080
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080

JWT_SECRET=replace-with-32-plus-random-chars
VIEWER_ACCESS_PASSWORD=replace-with-viewer-password
HOST_SHARED_SECRET=replace-with-host-shared-secret

# Optional STUN/TURN (required for manual「外网中继」/relay)
# Priority: process env > this file > WRD_TURN_JSON / ~/.StockHub/turn.json
# signal-server and python-host must resolve the same catalog; Host reads turn.json for multi-node switch.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional absolute path to JSON:
#   { "turnServers": [ { "host", "port", "username", "password", "transport", "remark" }, ... ] }
#   or legacy { "turnServer": { ... } }
# WRD_TURN_JSON=/Users/you/.StockHub/turn.json
# Optional default node id (otherwise prefer 阿里云 / aliyun)
# WRD_TURN_SERVER_ID=aliyun

# Host-local H.264 relay encoder policy. run-host-launchctl.sh exports this
# from this file; it is intentionally outside TURN credential loading.
# Allowed: relay-legacy-v1, relay-balanced-v2
WRD_RELAY_ENCODER_POLICY=relay-legacy-v1

# Optional diagnostics persistence (default off)
WRD_ENABLE_DIAG_PERSIST=0

# Shared Terminal hardening (disabled unless explicitly enabled)
WRD_ENABLE_TERMINAL=0
WRD_TERMINAL_ADMIN_PASSWORD=replace-with-terminal-admin-password
WRD_TERMINAL_SHELL=/bin/zsh
WRD_TERMINAL_CWD=
WRD_TERMINAL_PATH_EXTRA=
WRD_TERMINAL_ALLOW_POLLING=0
WRD_TERMINAL_RECORD_IO=0
WRD_TERMINAL_STARTUP_TIMEOUT_MS=10000
WRD_TERMINAL_PTY_KILL_WAIT_MS=200
WRD_TERMINAL_INPUT_BYTES_PER_SECOND=65536
WRD_TERMINAL_INPUT_BURST_BYTES=131072
WRD_TERMINAL_MAX_OBSERVER_QUEUE_BYTES=524288
WRD_TERMINAL_MAX_IN_FLIGHT_CHUNKS=32
WRD_TERMINAL_MAX_IN_FLIGHT_BYTES=65536
